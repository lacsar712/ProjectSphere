# Local offline defaults — no Cloudinary / SMTP required
JWT_SECRET=projectsphere_docker_jwt_secret_change_me
JWT_REFRESH_SECRET=projectsphere_docker_refresh_secret_change_me
ADMIN_EMAIL=admin@projectsphere.com
SEED_PASSWORD=Admin@1234
LOCAL_OFFLINE=true
SKIP_EMAIL_VERIFICATION=true

# Optional only if you want real email delivery later
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
